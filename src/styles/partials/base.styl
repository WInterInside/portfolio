:root {
	--page: #f7f9fc;
	--ink: #101820;
	--muted: #708394;
	--line: #dce5ed;
	--ice: #9bc8e8;
	--lilac: #c5bce8;
	--ease: cubic-bezier(0.2, 0.75, 0.25, 1);
}

*, *::before, *::after {
	box-sizing: border-box;
}

html {
	scroll-behavior: smooth;
}

body {
	margin: 0;
	background: var(--page);
	color: var(--ink);
	font-family: 'Gilroy', Arial, sans-serif;
	font-size: 16px;
	line-height: 1.5;
	-webkit-font-smoothing: antialiased;
}

button, a {
	-webkit-tap-highlight-color: transparent;
}

button {
	font: inherit;
}

a {
	color: inherit;
	text-decoration: none;
}

img, svg {
	display: block;
	max-width: 100%;
}

.snowflake-icon {
	width: 1em;
	height: 1em;
	flex: none;
}

h1, h2, h3, p {
	margin-top: 0;
}

[hidden] {
	display: none !important;
}

::selection {
	background: var(--ice);
	color: var(--ink);
}

:focus-visible {
	outline: 2px solid #4b86b4;
	outline-offset: 4px;
}

.container {
	width: calc(100% - 80px);
	max-width: 1320px;
	margin-inline: auto;
}

.site-shell {
	overflow: clip;
}

.section {
	padding-block: 132px;
}

.skip-link {
	position: fixed;
	z-index: 100;
	top: 12px;
	left: 12px;
	padding: 12px 18px;
	background: var(--ink);
	color: white;
	transform: translateY(-180%);

	&:focus {
		transform: translateY(0);
	}
}

.eyebrow {
	display: flex;
	align-items: center;
	gap: 12px;
	margin: 0 0 29px;
	color: #61788d;
	font-size: 11px;
	font-weight: 700;
	letter-spacing: 0.2em;
	line-height: 1.4;

	&__line {
		display: block;
		width: 28px;
		height: 1px;
		background: #8bb8d8;
	}
}

.section-heading {
	display: flex;
	justify-content: space-between;
	align-items: end;
	gap: 32px;
	margin-bottom: 48px;

	&__title {
		margin: 0;
		font-size: clamp(40px, 5.7vw, 76px);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.06em;
	}

	&__title em {
		color: #86abc6;
		font-style: normal;
	}

	&__aside {
		max-width: 260px;
		margin: 0 12px 6px 0;
		color: #6f8292;
		font-size: 15px;
		line-height: 1.65;
	}
}

.button {
	display: inline-flex;
	justify-content: space-between;
	align-items: center;
	gap: 20px;
	min-height: 58px;
	padding: 0 24px;
	border: 1px solid transparent;
	border-radius: 999px;
	font-size: 14px;
	font-weight: 700;
	white-space: nowrap;
	transition: background 0.25s, color 0.25s, border-color 0.25s;

	& span {
		font-size: 22px;
		font-weight: 400;
		line-height: 1;
	}

	&__telegram-icon {
		width: 20px;
		height: 20px;
		flex: none;
	}

	&--primary {
		background: var(--ink);
		color: white;
	}

	&--primary:hover {
		background: #293845;
	}

	&--light {
		background: #e9f0f7;
		color: var(--ink);
	}

	&--light:hover {
		background: white;
	}
}

.text-link {
	display: inline-flex;
	align-items: center;
	gap: 18px;
	padding-block: 8px;
	border-bottom: 1px solid #9bb2c4;
	font-size: 14px;
	font-weight: 700;
	transition: color 0.25s, border-color 0.25s;

	& span {
		font-size: 19px;
		font-weight: 400;
	}

	&:hover {
		color: #4b86b4;
		border-color: #4b86b4;
	}
}

[data-reveal] {
	opacity: 0;
	transform: translateY(26px);
	transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
}

[data-reveal].is-visible {
	opacity: 1;
	transform: translateY(0);
}

@media (max-width: 767px) {
	.container {
		width: calc(100% - 40px);
	}

	.section {
		padding-block: 88px;
	}

	.section-heading {
		display: block;
		margin-bottom: 32px;

		&__aside {
			margin: 20px 0 0;
		}

		&__title {
			font-size: clamp(38px, 10.5vw, 60px);
		}
	}
}

@media (max-width: 374px) {
	.container {
		width: calc(100% - 32px);
	}
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}

	*, *::before, *::after {
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.01ms !important;
	}

	[data-reveal] {
		opacity: 1;
		transform: none;
	}
}
