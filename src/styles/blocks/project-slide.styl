.project-slide {
	position: absolute;
	top: 0;
	left: 50%;
	display: grid;
	grid-template-columns: 1.05fr 0.95fr;
	width: min(1040px, 76vw);
	height: 550px;
	overflow: hidden;
	border: 1px solid #dbe6ef;
	border-radius: 18px;
	background: white;
	box-shadow: 0 28px 80px rgba(38, 67, 89, 0.1);
	transform: translateX(-50%) scale(0.86);
	opacity: 0;
	visibility: hidden;
	pointer-events: none;
	transition: transform 1.125s var(--ease), opacity 0.825s, visibility 1.125s, box-shadow 1.125s;

	&[data-state='active'] {
		z-index: 3;
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateX(-50%) scale(1);
		box-shadow: 0 32px 90px rgba(38, 67, 89, 0.15);
	}

	&[data-state='prev'] {
		z-index: 2;
		opacity: 0.52;
		visibility: visible;
		transform: translateX(calc(-50% - 67vw)) scale(0.84) rotate(-2deg);
	}

	&[data-state='next'] {
		z-index: 2;
		opacity: 0.52;
		visibility: visible;
		transform: translateX(calc(-50% + 67vw)) scale(0.84) rotate(2deg);
	}

	&__visual {
		position: relative;
		display: grid;
		place-items: center;
		min-width: 0;
		overflow: hidden;
		background: #111d20;
		color: white;
	}

	&__visual::before {
		position: absolute;
		inset: -20%;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 50%;
		transform: translate(40%, -25%);
		content: '';
	}

	&--geo-shield &__visual {
		background: linear-gradient(135deg, #1c211b, #514937 58%, #8c7b58);
	}

	&--tritet &__visual {
		background: linear-gradient(135deg, #1d2526, #5d5546 60%, #a28b65);
	}

	&--perfume &__visual {
		background: linear-gradient(135deg, #7f5e46, #c59e72 60%, #e9d2ad);
	}

	&--fishart &__visual {
		background: linear-gradient(135deg, #090d10, #193a3e 56%, #aa363b);
	}

	&--paramed &__visual {
		background: linear-gradient(135deg, #441b2a, #a92935 56%, #e8bdc4);
	}

	&--md-page &__visual {
		background: linear-gradient(135deg, #273c45, #6a8c90 58%, #d3e3df);
	}

	&--dobrocor &__visual {
		background: linear-gradient(135deg, #162c1b, #406b39 58%, #ed8c20);
	}

	&__visual-index, &__visual-caption {
		position: absolute;
		z-index: 2;
		left: 32px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	&__visual-index {
		top: 30px;
	}

	&__visual-caption {
		bottom: 30px;
	}

	&__preview-frame {
		position: relative;
		width: 84%;
		max-width: 490px;
		padding: 7px;
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-radius: 11px;
		background: rgba(255, 255, 255, 0.17);
		box-shadow: 0 26px 65px rgba(0, 0, 0, 0.32);
		transform: rotate(-3deg);
		animation: preview-float 7s ease-in-out infinite;
	}

	&__preview-bar {
		display: flex;
		align-items: center;
		gap: 5px;
		height: 24px;
		padding-inline: 9px;
		border-radius: 5px 5px 0 0;
		background: #f0f2f3;
	}

	&__preview-bar i {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #a8b5bc;
	}

	&__preview-image {
		width: 100%;
		height: auto;
		aspect-ratio: 1.6;
		object-fit: cover;
		object-position: center top;
		border-radius: 0 0 5px 5px;
	}

	&__content {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 40px;
	}

	&__meta {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		color: #7b91a1;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	&__copy {
		margin: auto 0;
	}

	&__title {
		margin: 0 0 16px;
		font-size: clamp(34px, 4vw, 60px);
		font-weight: 500;
		letter-spacing: -0.065em;
		line-height: 1;
	}

	&__description {
		max-width: 395px;
		margin: 0;
		color: #647989;
		font-size: 16px;
		line-height: 1.65;
	}

	&__bottom {
		padding-top: 17px;
		border-top: 1px solid #e1e9f0;
	}

	&__stack {
		margin: 0 0 17px;
		color: #8da1ae;
		font-size: 11px;
		letter-spacing: 0.03em;
	}

	&__actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}

	&__action {
		width: 100%;
		min-width: 0;
		min-height: 50px;
		padding-inline: 14px;
		font-size: 11px;
		cursor: pointer;
	}

	&__action span {
		font-size: 18px;
	}
}

@keyframes preview-float {
	50% {
		transform: rotate(-2deg) translateY(-9px);
	}
}

@media (max-width: 1100px) {
	.project-slide {
		width: 84vw;

		&__content {
			padding: 30px;
		}
	}
}

@media (min-width: 768px) and (max-width: 1100px) {
	.project-slide {
		&__action {
			justify-content: center;
		}

		&__action span[aria-hidden] {
			display: none;
		}
	}
}

@media (max-width: 767px) {
	.project-slide {
		grid-template-columns: 1fr;
		grid-template-rows: 280px 1fr;
		width: calc(100vw - 40px);
		height: 650px;
		border-radius: 14px;

		&[data-state='prev'], &[data-state='next'] {
			visibility: hidden;
			opacity: 0;
		}

		&__visual-index {
			top: 17px;
			left: 20px;
		}

		&__visual-caption {
			bottom: 15px;
			left: 20px;
		}

		&__preview-frame {
			width: min(78%, 420px);
		}

		&__content {
			padding: 24px;
		}

		&__title {
			margin-bottom: 10px;
			font-size: 39px;
		}

		&__description {
			font-size: 14px;
			line-height: 1.5;
		}

		&__stack {
			margin-bottom: 12px;
		}
	}
}

@media (max-width: 450px) {
	.project-slide {
		grid-template-rows: 240px 1fr;
		height: 680px;

		&__content {
			padding: 19px;
		}

		&__meta {
			font-size: 9px;
		}

		&__title {
			font-size: 36px;
		}

		&__actions {
			grid-template-columns: 1fr;
			gap: 8px;
		}

		&__action {
			min-height: 43px;
			font-size: 12px;
		}
	}
}

@media (max-width: 374px) {
	.project-slide {
		width: calc(100vw - 32px);
	}
}

@media (prefers-reduced-motion: reduce) {
	.project-slide {
		&__preview-frame {
			animation: none;
		}
	}
}
