.student-projects {
	margin-top: clamp(76px, 10vw, 140px);

	&__heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 28px;
		margin-bottom: 34px;
	}

	&__heading h3 {
		max-width: 760px;
		margin: 18px 0 0;
		font-size: clamp(38px, 4.7vw, 64px);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1.05;
	}

	&__heading h3 em {
		color: #88b0d0;
		font-style: normal;
	}

	&__heading > p {
		max-width: 285px;
		margin: 0 0 4px;
		color: #678299;
		font-size: 15px;
		line-height: 1.6;
	}

	&__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}

	&__card {
		min-width: 0;
		overflow: hidden;
		border: 1px solid #d4e3ee;
		border-radius: 24px;
		background: #fff;
		box-shadow: 0 24px 58px rgba(62, 102, 136, 0.07);
	}

	&__visual {
		position: relative;
		height: clamp(270px, 30vw, 370px);
		overflow: hidden;
	}

	&__visual-label {
		position: absolute;
		z-index: 2;
		top: 24px;
		left: 26px;
		padding: 8px 10px;
		border-radius: 6px;
		background: rgba(12, 20, 30, 0.55);
		color: #fff;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.28);
	}

	&__card--challenges &__visual {
		background: radial-gradient(circle at 75% 23%, #a391fc, transparent 40%), #694bc6;
	}

	&__hero-art {
		position: absolute;
		width: 76%;
		top: 18%;
		left: -7%;
		transform: rotate(-7deg);
		filter: drop-shadow(0 22px 25px rgba(27, 10, 74, 0.25));
	}

	&__phone-art {
		position: absolute;
		width: 65%;
		right: -8%;
		top: 20%;
		transform: rotate(9deg);
		filter: drop-shadow(0 23px 28px rgba(27, 10, 74, 0.25));
	}

	&__card--kazimir &__visual {
		background: #151515;
	}

	&__kazimir-art {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	&__card--sinaps {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
	}

	&__card--sinaps &__visual {
		height: auto;
		min-height: 340px;
		background: #050908;
	}

	&__sinaps-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	&__sinaps-scene {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(0, 0, 0, 0.15), transparent 55%), linear-gradient(0deg, rgba(0, 0, 0, 0.6), transparent 33%);
		color: #fff;
		pointer-events: none;
	}

	&__sinaps-top {
		position: absolute;
		top: 24px;
		right: 20px;
		left: 23%;
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 18px;
	}

	&__sinaps-top span {
		max-width: 225px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.3;
	}

	&__sinaps-top img {
		width: clamp(92px, 10vw, 155px);
		height: auto;
		flex: none;
	}

	&__sinaps-banner {
		position: absolute;
		inset: 0 auto 0 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		width: 18%;
		min-width: 80px;
		padding: 24px 9px 40px;
		background: rgba(0, 0, 0, 0.82);
	}

	&__sinaps-banner::after {
		position: absolute;
		top: 24px;
		right: 0;
		width: 7px;
		height: 66px;
		background: #00dc4c;
		content: '';
	}

	&__sinaps-banner img {
		max-width: 100%;
		height: 78%;
		object-fit: contain;
	}

	&__sinaps-banner span {
		display: flex;
		justify-content: space-between;
		width: 100%;
		color: #eef7f1;
		font-size: 8px;
		font-weight: 600;
		white-space: nowrap;
	}

	&__sinaps-banner b {
		font-weight: 600;
	}

	&__sinaps-module {
		position: absolute;
		font-size: clamp(22px, 3vw, 39px);
		font-weight: 300;
		letter-spacing: -0.055em;
		line-height: 1;
		white-space: nowrap;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
	}

	&__sinaps-module--one {
		top: 28%;
		left: 23%;
	}

	&__sinaps-module--two {
		top: 48%;
		left: 37%;
	}

	&__sinaps-module--three {
		bottom: 15%;
		left: 24%;
	}

	&__card--sinaps &__visual-label {
		top: auto;
		bottom: 13px;
		left: auto;
		right: 14px;
		font-size: 8px;
	}

	&__card--sinaps &__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	&__body {
		padding: clamp(26px, 3vw, 39px);
	}

	&__type {
		color: #7194ab;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	&__body h4 {
		margin: 16px 0 12px;
		font-size: clamp(32px, 3vw, 45px);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1.05;
	}

	&__body p {
		max-width: 510px;
		min-height: 80px;
		margin: 0 0 23px;
		color: #617e92;
		font-size: 15px;
		line-height: 1.6;
	}

	&__actions {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	&__actions .button {
		min-width: 0;
		min-height: 50px;
		padding-inline: 18px;
		font-size: 12px;
		cursor: pointer;
	}
}

@media (max-width: 900px) {
	.student-projects {
		&__grid {
			grid-template-columns: 1fr;
		}

		&__card--sinaps {
			grid-template-columns: 1fr;
		}

		&__visual {
			height: clamp(270px, 52vw, 380px);
		}

		&__card--sinaps &__visual {
			height: clamp(270px, 52vw, 380px);
			min-height: 0;
		}
	}
}

@media (max-width: 600px) {
	.student-projects {
		&__sinaps-banner {
			min-width: 68px;
			padding: 17px 6px 32px;
		}

		&__sinaps-banner::after {
			top: 18px;
			width: 5px;
			height: 46px;
		}

		&__sinaps-banner span {
			font-size: 6px;
		}

		&__sinaps-top {
			top: 20px;
			right: 12px;
			left: 25%;
			gap: 7px;
		}

		&__sinaps-top span {
			font-size: 8px;
		}

		&__sinaps-top img {
			width: 88px;
		}

		&__sinaps-module {
			font-size: clamp(18px, 5vw, 27px);
		}

		&__sinaps-module--one {
			left: 25%;
		}

		&__sinaps-module--two {
			left: 31%;
		}

		&__sinaps-module--three {
			left: 24%;
		}

		&__heading {
			display: block;
		}

		&__heading > p {
			margin-top: 16px;
		}

		&__body p {
			min-height: 0;
		}
	}
}
