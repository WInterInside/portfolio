.student-reviews {
	margin-top: clamp(76px, 10vw, 140px);

	&__heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 34px;
	}

	&__heading h3 {
		margin: 18px 0 0;
		font-size: clamp(39px, 4.7vw, 64px);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1.05;
	}

	&__heading h3 em {
		color: #88b0d0;
		font-style: normal;
	}

	&__heading > p {
		max-width: 260px;
		margin: 0 0 4px;
		color: #678299;
		font-size: 15px;
		line-height: 1.6;
	}

	&__viewport {
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-inline: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	&__viewport::-webkit-scrollbar {
		display: none;
	}

	&__track {
		position: relative;
		display: flex;
		align-items: stretch;
		gap: 18px;
	}

	&__card {
		display: flex;
		flex-direction: column;
		flex: 0 0 calc(((100% - 18px) / 2));
		min-width: 0;
		min-height: 330px;
		margin: 0;
		padding: clamp(26px, 3vw, 38px);
		border: 1px solid #d4e3ee;
		border-radius: 23px;
		background: rgba(255, 255, 255, 0.83);
		box-shadow: 0 18px 44px rgba(62, 102, 136, 0.06);
		scroll-snap-align: none;
	}

	&__card:nth-child(odd) {
		scroll-snap-align: start;
	}

	&__rating {
		display: flex;
		align-items: center;
		gap: 3px;
		color: #e2a736;
	}

	&__rating svg {
		width: 16px;
		height: 16px;
		flex: none;
	}

	&__rating span {
		margin-left: auto;
		color: #809bad;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	&__card blockquote {
		margin: 30px 0 0;
		font-size: clamp(18px, 1.65vw, 22px);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.5;
	}

	&__card figcaption {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 15px;
		margin-top: auto;
		padding-top: 30px;
		border-top: 1px solid #dfebf3;
		font-size: 13px;
	}

	&__card figcaption > span:first-child {
		display: grid;
		gap: 5px;
	}

	&__card strong {
		font-weight: 700;
	}

	&__card small {
		color: #7894a8;
		font-size: 12px;
	}

	&__original {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 9px 12px;
		border: 1px solid #c9dce9;
		border-radius: 999px;
		background: transparent;
		color: #315e80;
		font-family: inherit;
		font-size: 12px;
		font-weight: 600;
		white-space: nowrap;
		cursor: pointer;
		transition: border-color 0.25s, background-color 0.25s, color 0.25s;
	}

	&__original:hover {
		border-color: #8db8d4;
		background: #e6f3fb;
		color: #0d6caa;
	}

	&__controls {
		display: flex;
		align-items: center;
		gap: 22px;
		margin-top: 30px;
	}

	&__count {
		color: #1c3346;
		font-size: 18px;
		font-weight: 600;
		white-space: nowrap;
	}

	&__count span:last-child {
		color: #93aabe;
		font-size: 12px;
		font-weight: 400;
	}

	&__progress {
		height: 2px;
		flex: 1;
		overflow: hidden;
		background: #cfdfe9;
	}

	&__progress span {
		display: block;
		width: 33.333%;
		height: 100%;
		background: #83b8dc;
		transition: width 0.35s var(--ease);
	}

	&__arrows {
		display: flex;
		gap: 8px;
	}

	&__arrows button {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid #c3d9e8;
		border-radius: 50%;
		background: transparent;
		color: #254b66;
		font: inherit;
		font-size: 22px;
		cursor: pointer;
		transition: background 0.2s, border-color 0.2s;
	}

	&__arrows button:hover:not(:disabled) {
		border-color: #8eb9d8;
		background: #e5f2fb;
	}

	&__arrows button:disabled {
		opacity: 0.35;
		cursor: default;
	}
}

@media (max-width: 900px) {
	.student-reviews {
		&__card {
			flex-basis: 100%;
			scroll-snap-align: start;
		}
	}
}

@media (max-width: 850px) {
	.student-reviews {
		scroll-margin-top: 72px;
	}
}

@media (max-width: 600px) {
	.student-reviews {
		&__controls {
			gap: 12px;
		}

		&__heading {
			display: block;
		}

		&__heading > p {
			margin-top: 16px;
		}

		&__card {
			min-height: 240px;
		}
	}
}
