.projects
	position: relative;
	background: #f7f9fc;

.project-showcase
	position: relative;

.project-showcase__viewport
	position: relative;
	height: 600px;
	outline-offset: -8px;
	touch-action: pan-y;
	cursor: grab;

.project-showcase__viewport:active
	cursor: grabbing;

.project-showcase__track
	position: relative;
	height: 100%;

.project-slide
	position: absolute;
	top: 0;
	left: 50%;
	display: grid;
	grid-template-columns: 1.05fr 0.95fr;
	width: min(1040px, 76vw);
	height: 550px;
	overflow: hidden;
	border: 1px solid #dbe6ef;
	border-radius: 18px;
	background: white;
	box-shadow: 0 28px 80px rgba(38, 67, 89, 0.1);
	transform: translateX(-50%) scale(0.86);
	opacity: 0;
	visibility: hidden;
	pointer-events: none;
	transition: transform 0.75s var(--ease), opacity 0.55s, visibility 0.75s, box-shadow 0.75s;

.project-slide[data-state='active']
	z-index: 3;
	opacity: 1;
	visibility: visible;
	pointer-events: auto;
	transform: translateX(-50%) scale(1);
	box-shadow: 0 32px 90px rgba(38, 67, 89, 0.15);

.project-slide[data-state='prev']
	z-index: 2;
	opacity: 0.52;
	visibility: visible;
	transform: translateX(calc(-50% - 67vw)) scale(0.84) rotate(-2deg);

.project-slide[data-state='next']
	z-index: 2;
	opacity: 0.52;
	visibility: visible;
	transform: translateX(calc(-50% + 67vw)) scale(0.84) rotate(2deg);

.project-slide__visual
	position: relative;
	display: grid;
	place-items: center;
	min-width: 0;
	overflow: hidden;
	background: #111d20;
	color: white;

.project-slide__visual::before
	position: absolute;
	inset: -20%;
	border: 1px solid rgba(255, 255, 255, 0.12);
	border-radius: 50%;
	transform: translate(40%, -25%);
	content: '';

.project-slide--sinaps .project-slide__visual
	background: radial-gradient(circle at 75% 70%, #15402d, transparent 45%), #040b0a;

.project-slide--evolution .project-slide__visual
	background: linear-gradient(135deg, #092a1b, #3b8853 55%, #b2dc6d);

.project-slide--geo-shield .project-slide__visual
	background: linear-gradient(135deg, #1c211b, #514937 58%, #8c7b58);

.project-slide--tritet .project-slide__visual
	background: linear-gradient(135deg, #1d2526, #5d5546 60%, #a28b65);

.project-slide--perfume .project-slide__visual
	background: linear-gradient(135deg, #7f5e46, #c59e72 60%, #e9d2ad);

.project-slide--fishart .project-slide__visual
	background: linear-gradient(135deg, #090d10, #193a3e 56%, #aa363b);

.project-slide--kazimir .project-slide__visual
	background: linear-gradient(135deg, #0d0d0d, #812b25 58%, #d79f30);

.project-slide__visual-index, .project-slide__visual-caption
	position: absolute;
	z-index: 2;
	left: 32px;
	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.16em;
	text-transform: uppercase;

.project-slide__visual-index
	top: 30px;

.project-slide__visual-caption
	bottom: 30px;

.project-slide__preview-frame
	position: relative;
	width: 84%;
	max-width: 490px;
	padding: 7px;
	border: 1px solid rgba(255, 255, 255, 0.34);
	border-radius: 11px;
	background: rgba(255, 255, 255, 0.17);
	box-shadow: 0 26px 65px rgba(0, 0, 0, 0.32);
	transform: rotate(-3deg);
	animation: preview-float 7s ease-in-out infinite;

.project-slide__preview-bar
	display: flex;
	align-items: center;
	gap: 5px;
	height: 24px;
	padding-inline: 9px;
	border-radius: 5px 5px 0 0;
	background: #f0f2f3;

.project-slide__preview-bar i
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: #a8b5bc;

.project-slide__preview-image
	width: 100%;
	height: auto;
	aspect-ratio: 1.6;
	object-fit: cover;
	object-position: center top;
	border-radius: 0 0 5px 5px;

.project-slide__content
	display: flex;
	flex-direction: column;
	min-width: 0;
	padding: 40px;

.project-slide__meta
	display: flex;
	justify-content: space-between;
	gap: 12px;
	color: #7b91a1;
	font-size: 11px;
	font-weight: 700;
	letter-spacing: 0.1em;
	text-transform: uppercase;

.project-slide__copy
	margin: auto 0;

.project-slide__title
	margin: 0 0 16px;
	font-size: clamp(34px, 4vw, 60px);
	font-weight: 500;
	letter-spacing: -0.065em;
	line-height: 1;

.project-slide__description
	max-width: 395px;
	margin: 0;
	color: #647989;
	font-size: 16px;
	line-height: 1.65;

.project-slide__bottom
	padding-top: 17px;
	border-top: 1px solid #e1e9f0;

.project-slide__stack
	margin: 0 0 17px;
	color: #8da1ae;
	font-size: 11px;
	letter-spacing: 0.03em;

.project-slide__actions
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 10px;

.project-slide__action
	width: 100%;
	min-width: 0;
	min-height: 50px;
	padding-inline: 14px;
	font-size: 11px;
	cursor: pointer;

.project-slide__action span
	font-size: 18px;

.button--outline
	border-color: #c8d9e4;
	background: transparent;
	color: #2c4b61;

.button--outline:hover
	border-color: #80aeca;
	background: #eaf4fa;
	color: #1e5e88;

.project-showcase__controls
	display: flex;
	align-items: center;
	gap: 25px;

.project-showcase__counter
	display: flex;
	gap: 5px;
	align-items: baseline;
	min-width: 78px;
	color: #9aabb8;
	font-size: 13px;

.project-showcase__counter strong
	color: var(--ink);
	font-size: 24px;
	font-weight: 500;

.project-showcase__progress
	height: 2px;
	flex: 1;
	overflow: hidden;
	background: #dce5ed;

.project-showcase__progress span
	display: block;
	width: 14.3%;
	height: 100%;
	background: #85b6d8;
	transition: width 0.6s var(--ease);

.project-showcase__actions
	display: flex;
	gap: 8px;

.icon-button
	display: grid;
	place-items: center;
	width: 44px;
	height: 44px;
	border: 1px solid #cfdde7;
	border-radius: 50%;
	background: transparent;
	color: #22333f;
	font-size: 20px;
	cursor: pointer;
	transition: color 0.25s, border-color 0.25s, background 0.25s;

.icon-button:hover
	border-color: #a3c4db;
	background: #e7f2f9;
	color: #347bab;

.icon-button[data-carousel-pause]
	font-size: 17px;

.project-preview[open]
	position: fixed;
	inset: 0;
	z-index: 50;
	display: flex;
	flex-direction: column;
	width: calc(100vw - 40px);
	max-width: 1100px;
	max-height: none;
	height: min(92dvh, 1000px);
	margin: auto;
	padding: 0;
	overflow: hidden;
	border: 1px solid #d4e1e9;
	border-radius: 20px;
	background: #f4f8fb;
	box-shadow: 0 35px 90px rgba(7, 22, 33, 0.3);

.project-preview::backdrop
	background: rgba(8, 22, 32, 0.72);
	backdrop-filter: blur(8px);

.project-preview__header
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 18px;
	min-height: 82px;
	padding: 16px 22px;
	border-bottom: 1px solid #dbe7ee;
	background: #f8fbfd;

.project-preview__eyebrow
	display: block;
	color: #7c9aaa;
	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.16em;

.project-preview__title
	margin: 4px 0 0;
	font-size: 23px;
	font-weight: 600;
	letter-spacing: -0.04em;
	line-height: 1.1;

.project-preview__controls
	display: flex;
	align-items: center;
	gap: 10px;

.project-preview__zoom, .project-preview__close
	border: 1px solid #c9dbe6;
	background: white;
	color: #25475d;
	cursor: pointer;
	transition: background 0.2s, border-color 0.2s;

.project-preview__zoom:hover, .project-preview__close:hover
	border-color: #89b6d1;
	background: #eaf4f9;

.project-preview__zoom
	min-height: 38px;
	padding-inline: 14px;
	border-radius: 22px;
	font-size: 12px;
	font-weight: 700;

.project-preview__close
	width: 39px;
	height: 39px;
	border-radius: 50%;
	font-size: 27px;
	line-height: 1;

.project-preview__scroll
	flex: 1;
	min-height: 0;
	overflow: auto;
	overscroll-behavior: contain;
	background: #e8eef2;

.project-preview__image
	display: block;
	width: 100%;
	max-width: none;
	height: auto;
	margin-inline: auto;
	background: white;

.project-preview--zoomed .project-preview__image
	width: 1248px;

body.is-preview-open
	overflow: hidden;

@keyframes preview-float
	50%
		transform: rotate(-2deg) translateY(-9px);

@media (max-width: 1100px)
	.project-slide
		width: 84vw;

	.project-slide__content
		padding: 30px;

@media (max-width: 767px)
	.project-showcase__viewport
		height: 680px;

	.project-slide
		grid-template-columns: 1fr;
		grid-template-rows: 280px 1fr;
		width: calc(100vw - 40px);
		height: 650px;
		border-radius: 14px;

	.project-slide[data-state='prev'], .project-slide[data-state='next']
		visibility: hidden;
		opacity: 0;

	.project-slide__visual-index
		top: 17px;
		left: 20px;

	.project-slide__visual-caption
		bottom: 15px;
		left: 20px;

	.project-slide__preview-frame
		width: min(78%, 420px);

	.project-slide__content
		padding: 24px;

	.project-slide__title
		margin-bottom: 10px;
		font-size: 39px;

	.project-slide__description
		font-size: 14px;
		line-height: 1.5;

	.project-slide__stack
		margin-bottom: 12px;

	.project-showcase__controls
		gap: 15px;

	.project-preview[open]
		width: calc(100vw - 20px);
		height: calc(100dvh - 20px);
		border-radius: 14px;

@media (max-width: 450px)
	.project-showcase__viewport
		height: 710px;

	.project-slide
		grid-template-rows: 240px 1fr;
		height: 680px;

	.project-slide__content
		padding: 19px;

	.project-slide__meta
		font-size: 9px;

	.project-slide__title
		font-size: 36px;

	.project-slide__actions
		grid-template-columns: 1fr;
		gap: 8px;

	.project-slide__action
		min-height: 43px;
		font-size: 12px;

	.project-preview__header
		min-height: 72px;
		padding: 12px;

	.project-preview__title
		font-size: 18px;

	.project-preview__zoom
		padding-inline: 10px;
		font-size: 11px;

@media (max-width: 374px)
	.project-slide
		width: calc(100vw - 32px);

	.project-showcase__controls
		gap: 8px;

	.project-showcase__counter
		min-width: 55px;

	.icon-button
		width: 39px;
		height: 39px;

@media (prefers-reduced-motion: reduce)
	.project-slide__preview-frame
		animation: none;
