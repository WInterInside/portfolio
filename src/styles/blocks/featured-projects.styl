.featured-project
	position: relative;
	display: flex;
	align-items: center;
	min-height: 100svh;
	overflow: hidden;
	background: radial-gradient(circle at 72% 45%, #264045 0, transparent 42%), #111d22;
	color: #edf3f3;

.featured-project::before
	position: absolute;
	inset: 0;
	background-image: linear-gradient(rgba(179, 204, 199, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(179, 204, 199, 0.035) 1px, transparent 1px);
	background-size: 56px 56px;
	content: '';
	pointer-events: none;

.featured-project--bird
	background: radial-gradient(circle at 72% 45%, #314b5b 0, transparent 46%), #142633;

.featured-project--yoga
	background: radial-gradient(circle at 72% 45%, #475845 0, transparent 46%), #1a2823;

.featured-project__inner
	position: relative;
	z-index: 1;
	display: grid;
	grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1.28fr);
	align-items: center;
	gap: clamp(35px, 5vw, 85px);

.featured-project .eyebrow
	color: #a5bdbb;

.featured-project__label
	margin: 56px 0 15px;
	color: #c8a57c;
	font-size: 12px;
	font-weight: 700;
	letter-spacing: 0.18em;
	text-transform: uppercase;

.featured-project__title
	margin: 0;
	font-size: clamp(68px, 8vw, 124px);
	font-weight: 500;
	line-height: 0.9;
	letter-spacing: -0.085em;

.featured-project__title em
	color: #9fbdb8;
	font-style: normal;

.featured-project--bird .featured-project__title em
	color: #b6d7e6;

.featured-project--yoga .featured-project__title
	font-size: clamp(52px, 6vw, 96px);

.featured-project--yoga .featured-project__title em
	color: #bbd1ae;

.featured-project__description
	max-width: 470px;
	margin: 30px 0;
	color: #bbcac9;
	font-size: 17px;
	line-height: 1.7;

.featured-project__actions
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 12px;
	width: min(100%, 460px);

.featured-project__actions[data-single-action]
	grid-template-columns: minmax(0, 260px);

.featured-project__actions .button
	width: 100%;
	min-width: 0;
	min-height: 58px;
	padding-inline: 18px;
	font-size: 13px;

.featured-project__source
	border-color: rgba(169, 197, 190, 0.45);
	background: rgba(255, 255, 255, 0.04);
	color: #e4efed;

.featured-project__source:hover
	border-color: #b5d6cd;
	background: rgba(255, 255, 255, 0.13);

.featured-project__play-icon
	width: 22px;
	height: 22px;
	flex: none;

.featured-project__stack
	margin: 32px 0 0;
	color: #8ea5a2;
	font-size: 11px;
	font-weight: 700;
	letter-spacing: 0.1em;

.featured-project__visual
	position: relative;
	margin: 0;
	padding: 12px;
	border: 1px solid rgba(169, 197, 190, 0.24);
	border-radius: 18px;
	background: rgba(217, 235, 230, 0.04);
	box-shadow: 0 35px 90px rgba(0, 0, 0, 0.28);

.featured-project__visual::after
	position: absolute;
	inset: -22px;
	border: 1px solid rgba(169, 197, 190, 0.08);
	border-radius: 32px;
	content: '';
	pointer-events: none;

.featured-project__image-wrap
	width: 100%;
	aspect-ratio: 1.9;
	overflow: hidden;
	border-radius: 9px;

.featured-project__image-wrap img
	width: 100%;
	height: 100%;
	object-fit: cover;
	object-position: center;

.featured-project--yoga .featured-project__image-wrap img
	width: 106%;
	max-width: none;
	margin: -2% 0 0 -3%;

.featured-project__visual figcaption
	padding: 13px 4px 2px;
	color: #9db1ad;
	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.13em;
	text-transform: uppercase;

@media (max-width: 1100px)
	.featured-project__inner
		grid-template-columns: 1fr;
		gap: 52px;

	.featured-project__label
		margin-top: 32px;

	.featured-project__visual
		max-width: 900px;

@media (max-width: 767px)
	.featured-project__inner
		gap: 38px;

	.featured-project__title
		font-size: clamp(64px, 14vw, 96px);

	.featured-project--yoga .featured-project__title
		font-size: clamp(44px, 11vw, 80px);

	.featured-project__description
		margin: 22px 0;
		font-size: 15px;

	.featured-project__stack
		margin-top: 25px;

@media (max-width: 450px)
	.featured-project__actions
		grid-template-columns: 1fr;
		max-width: 280px;

	.featured-project__actions[data-single-action]
		max-width: 280px;

	.featured-project__actions .button
		min-height: 52px;

@media (max-width: 374px)
	.featured-project__title
		font-size: 58px;

	.featured-project--yoga .featured-project__title
		font-size: 41px;
