.emails {
	background: #f7fafc;

	&__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	&__card {
		min-width: 0;
		overflow: hidden;
		border: 1px solid #d9e6ee;
		border-radius: 24px;
		background: #fff;
		box-shadow: 0 25px 60px rgba(28, 63, 86, 0.06);
	}

	&__card--wide {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	&__card--wide &__visual {
		height: 100%;
		min-height: 310px;
	}

	&__card--wide &__card-body {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	&__card--wide &__actions {
		max-width: 430px;
	}

	&__visual {
		display: grid;
		place-items: center;
		height: 310px;
		overflow: hidden;
	}

	&__visual--sheer {
		background: radial-gradient(circle at 70% 30%, #f6fbff, transparent 45%), linear-gradient(135deg, #c6dbe7, #e9f2f7);
	}

	&__visual--sales {
		background: radial-gradient(circle at 75% 25%, #f4f9ff, transparent 43%), linear-gradient(145deg, #dce8f1, #b5cfe3);
	}

	&__visual--sales &__mail-window {
		transform: translateY(30px) rotate(4deg);
	}

	&__mail-window {
		width: min(69%, 300px);
		height: 265px;
		overflow: hidden;
		border: 1px solid #fff;
		border-radius: 12px 12px 0 0;
		background: #fff;
		box-shadow: 0 25px 50px rgba(23, 54, 77, 0.18);
		transform: translateY(30px) rotate(-5deg);
	}

	&__mail-bar {
		display: flex;
		align-items: center;
		gap: 5px;
		height: 27px;
		padding: 0 10px;
		background: #f4f7fa;
	}

	&__mail-bar span {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #9db8ca;
	}

	&__mail-window img {
		display: block;
		width: 100%;
		height: auto;
	}

	&__visual--ohta {
		background: radial-gradient(circle at 26% 74%, rgba(194, 218, 211, 0.9), transparent 45%), #e5edeb;
	}

	&__ticket {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 210px;
		min-height: 275px;
		padding: 30px 24px;
		border-radius: 6px;
		background: #fff;
		box-shadow: 0 25px 50px rgba(31, 72, 68, 0.16);
		transform: translateY(25px) rotate(5deg);
	}

	&__ticket img {
		width: 110px;
		max-height: 55px;
		object-fit: contain;
	}

	&__ticket > span {
		margin-top: 20px;
		color: #203b42;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.15em;
	}

	&__ticket i {
		width: 100%;
		height: 1px;
		margin: 18px 0;
		background: #cbdad6;
	}

	&__ticket small {
		align-self: flex-start;
		color: #6f8a89;
		font-size: 10px;
	}

	&__ticket b {
		align-self: flex-start;
		width: 100%;
		height: 6px;
		margin-top: 11px;
		border-radius: 4px;
		background: #e8eeed;
	}

	&__ticket &__ticket-line--short {
		width: 58%;
	}

	&__card-body {
		padding: 32px clamp(25px, 3vw, 40px) 38px;
	}

	&__type {
		color: #7194ab;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	&__card-body h3 {
		margin: 17px 0 14px;
		font-size: clamp(31px, 3vw, 43px);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1.05;
	}

	&__card-body p {
		min-height: 78px;
		max-width: 480px;
		margin: 0 0 20px;
		color: #637b8e;
		font-size: 15px;
		line-height: 1.6;
	}

	&__actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}

	&__actions .button {
		width: 100%;
		min-width: 0;
		min-height: 50px;
		padding-inline: 16px;
		font-size: 12px;
		cursor: pointer;
	}

	&__actions .button span {
		font-size: 18px;
	}
}

@media (max-width: 800px) {
	.emails {
		&__grid {
			grid-template-columns: 1fr;
		}

		&__card--wide {
			grid-template-columns: 1fr;
		}

		&__card--wide &__visual {
			min-height: 310px;
		}

		&__card-body p {
			min-height: 0;
		}
	}
}

@media (max-width: 450px) {
	.emails {
		&__visual {
			height: 245px;
		}

		&__mail-window {
			height: 220px;
		}

		&__ticket {
			min-height: 245px;
			padding: 20px;
		}

		&__card-body {
			padding: 28px 24px 32px;
		}

		&__actions {
			grid-template-columns: 1fr;
		}
	}
}
