.site-header
	position: absolute;
	inset: 0 0 auto;
	z-index: 40;

.site-header__inner
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 92px;

.site-header__brand
	display: inline-flex;
	align-items: center;
	gap: 11px;
	font-size: 16px;
	font-weight: 700;
	letter-spacing: -0.04em;

.site-header__brand-mark
	display: block;
	width: 34px;
	height: 34px;
	flex: none;

.site-header__brand-name span
	color: #769bb7;

.site-header__nav
	display: flex;
	align-items: center;
	gap: clamp(22px, 3vw, 44px);

.site-header__nav-link
	color: #4a5f70;
	font-size: 13px;
	font-weight: 600;
	transition: color 0.2s;

.site-header__nav-link:hover
	color: #0d6caa;

.site-header__nav-cta
	display: inline-flex;
	gap: 14px;
	align-items: center;
	padding: 10px 0 10px 20px;
	border-left: 1px solid #cfdae4;
	font-size: 13px;
	font-weight: 700;
	transition: color 0.2s;

.site-header__nav-cta:hover
	color: #0d6caa;

.site-header__nav-cta span
	font-size: 18px;
	font-weight: 400;

.site-header__menu-toggle
	display: none;

@media (max-width: 700px)
	.site-header__inner
		min-height: 74px;

	.site-header__menu-toggle
		position: relative;
		z-index: 42;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid #c5d8e5;
		border-radius: 50%;
		background: #f7f9fc;
		cursor: pointer;

	.site-header__menu-bars, .site-header__menu-snowflake
		grid-area: 1 / 1;
		transition: opacity 0.25s, transform 0.25s;

	.site-header__menu-bars
		display: grid;
		gap: 4px;

	.site-header__menu-bar
		display: block;
		width: 19px;
		height: 1.5px;
		border-radius: 1px;
		background: var(--ink);

	.site-header__menu-snowflake
		width: 22px;
		height: 22px;
		color: #426e8e;
		opacity: 0;
		transform: scale(0.7) rotate(-30deg);

	.site-header__menu-toggle[aria-expanded='true'] .site-header__menu-bars
		opacity: 0;
		transform: scale(0.7) rotate(30deg);

	.site-header__menu-toggle[aria-expanded='true'] .site-header__menu-snowflake
		opacity: 1;
		transform: none;

	.site-header__nav
		position: fixed;
		z-index: 41;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: 24px;
		padding: 80px 10vw;
		background: #e9f0f7;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-12px);
		transition: opacity 0.3s, transform 0.3s, visibility 0.3s;

	.site-header__nav.is-open
		opacity: 1;
		visibility: visible;
		transform: translateY(0);

	.site-header__nav-link
		font-size: clamp(30px, 9vw, 48px);
		font-weight: 500;
		letter-spacing: -0.05em;

	.site-header__nav-cta
		margin-top: 18px;
		padding: 12px 0;
		border-left: 0;
		border-bottom: 1px solid #aabfcf;
		font-size: 17px;
