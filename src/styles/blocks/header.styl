.site-header {
	position: absolute;
	inset: 0 0 auto;
	z-index: 40;

	&__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 92px;
	}

	&__brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		font-size: 16px;
		font-weight: 700;
		letter-spacing: -0.04em;
	}

	&__brand-mark {
		display: block;
		width: 40px;
		height: 40px;
		flex: none;
		border: 1px solid rgba(118, 155, 183, 0.45);
		border-radius: 50%;
		background: #dcebf4;
		object-fit: cover;
	}

	&__brand-name span {
		color: #769bb7;
	}

	&__menu-toggle {
		display: none;
	}

	&__nav {
		display: flex;
		align-items: center;
		gap: clamp(22px, 3vw, 44px);
	}

	&__nav-link {
		color: #4a5f70;
		font-size: 13px;
		font-weight: 600;
		transition: color 0.2s;
	}

	&__nav-link:hover {
		color: #0d6caa;
	}

	&__nav-link--students {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 8px 12px;
		border: 1px solid #cbd8ec;
		border-radius: 999px;
		background: rgba(223, 229, 250, 0.58);
		color: #456c92;
		white-space: nowrap;
		transition: color 0.25s, border-color 0.25s, background-color 0.25s;
	}

	&__nav-link--students:hover {
		border-color: #9dbbe0;
		background: #e1edfb;
	}

	&__student-icon {
		color: #a297d9;
		font-size: 15px;
	}

	&__nav-cta {
		display: inline-flex;
		gap: 14px;
		align-items: center;
		padding: 10px 0 10px 20px;
		border-left: 1px solid #cfdae4;
		font-size: 13px;
		font-weight: 700;
		transition: color 0.2s;
	}

	&__nav-cta:hover {
		color: #0d6caa;
	}

	&__nav-cta span {
		font-size: 18px;
		font-weight: 400;
	}
}

@media (max-width: 850px) {
	.site-header {
		position: fixed;
		background: linear-gradient(120deg, rgba(255, 255, 255, 0.66), rgba(220, 237, 249, 0.56));
		border-bottom: 1px solid rgba(255, 255, 255, 0.5);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65);
		backdrop-filter: blur(24px) saturate(1.6);
		transition: background 0.25s, box-shadow 0.25s, border-color 0.25s;

		&.is-compact {
			background: linear-gradient(120deg, rgba(255, 255, 255, 0.72), rgba(220, 237, 249, 0.65));
			border-color: rgba(255, 255, 255, 0.62);
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72), 0 8px 26px rgba(29, 58, 80, 0.1);
		}

		&__inner {
			min-height: 58px;
			gap: 10px;
			transition: min-height 0.25s;
		}

		&.is-compact &__inner {
			min-height: 44px;
		}

		&__brand {
			flex: none;
			gap: 0;
		}

		&__brand-mark {
			width: 36px;
			height: 36px;
		}

		&__brand-name {
			display: none;
		}

		&__menu-toggle {
			display: grid;
			place-items: center;
			width: 36px;
			height: 36px;
			flex: none;
			padding: 0;
			border: 1px solid #c5d8e5;
			border-radius: 50%;
			background: rgba(247, 249, 252, 0.74);
			color: #426e8e;
			cursor: pointer;
			transition: background-color 0.25s, border-color 0.25s;
		}

		&__menu-toggle:hover, &.is-menu-open &__menu-toggle {
			border-color: #9dbbe0;
			background: rgba(247, 249, 252, 0.94);
		}

		&__menu-bars, &__menu-snowflake {
			grid-area: 1 / 1;
			transition: opacity 0.25s, transform 0.25s;
		}

		&__menu-bars {
			display: grid;
			gap: 4px;
		}

		&__menu-bar {
			display: block;
			width: 19px;
			height: 1.5px;
			border-radius: 1px;
			background: currentColor;
		}

		&__menu-snowflake {
			width: 22px;
			height: 22px;
			opacity: 0;
			transform: scale(0.7) rotate(-30deg);
		}

		&__menu-toggle[aria-expanded='true'] &__menu-bars {
			opacity: 0;
			transform: scale(0.7) rotate(30deg);
		}

		&__menu-toggle[aria-expanded='true'] &__menu-snowflake {
			opacity: 1;
			transform: none;
		}

		&__nav {
			position: absolute;
			top: calc(100% + 8px);
			right: 20px;
			display: grid;
			gap: 2px;
			width: calc(100% - 40px);
			max-width: 320px;
			max-height: calc(100dvh - 74px);
			padding: 10px;
			overflow-y: auto;
			border: 1px solid rgba(255, 255, 255, 0.72);
			border-radius: 22px;
			background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(224, 239, 250, 0.9));
			box-shadow: 0 20px 44px rgba(23, 49, 69, 0.18);
			backdrop-filter: blur(24px) saturate(1.5);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-8px);
			pointer-events: none;
			transition: opacity 0.25s, visibility 0.25s, transform 0.25s var(--ease);
		}

		&.is-menu-open &__nav {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
			pointer-events: auto;
		}

		&__nav-link, &__nav-cta {
			display: flex;
			align-items: center;
			justify-content: space-between;
			min-height: 42px;
			padding: 10px 14px;
			border-radius: 12px;
			color: #274b63;
			font-size: 13px;
			font-weight: 700;
			letter-spacing: 0;
		}

		&__nav-link:hover, &__nav-cta:hover, &__nav-link[aria-current='location'] {
			background: rgba(205, 227, 243, 0.68);
			color: #153b56;
		}

		&__nav-link--students {
			border: 0;
			background: transparent;
		}

		&__student-icon {
			font-size: 14px;
		}

		&__nav-cta {
			border-left: 0;
			gap: 8px;
		}

		&__nav-cta span {
			font-size: 15px;
			line-height: 1;
		}
	}
}
