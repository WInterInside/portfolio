.about {
	background: linear-gradient(135deg, #eaf1f7, #f1f5f9 64%, #e7ecf7);

	&__layout {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(50px, 8vw, 130px);
		align-items: center;
	}

	&__description {
		max-width: 440px;
		margin: 30px 0 35px;
		color: #667c8e;
		font-size: 17px;
		line-height: 1.7;
	}
}

.approach-tabs {
	overflow: hidden;
	border: 1px solid #d5e3ec;
	border-radius: 20px;
	background: rgba(255, 255, 255, 0.6);
	box-shadow: 0 25px 70px rgba(80, 111, 133, 0.08);

	&__list {
		display: flex;
		border-bottom: 1px solid #d5e3ec;
	}

	&__tab {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		flex: 1;
		min-height: 70px;
		padding: 12px;
		border: 0;
		background: transparent;
		color: #9aabb9;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.02em;
		cursor: pointer;
		transition: color 0.25s, background 0.25s;
	}

	&__tab + &__tab {
		border-left: 1px solid #e2eaf0;
	}

	&__tab span {
		color: #708597;
		font-size: 13px;
	}

	&__tab[aria-selected='true'] {
		background: rgba(255, 255, 255, 0.7);
		color: #5186ab;
	}

	&__tab[aria-selected='true'] span {
		color: var(--ink);
	}

	&__tab[aria-selected='true']::after {
		position: absolute;
		bottom: -1px;
		left: 0;
		right: 0;
		height: 2px;
		background: #8abbdc;
		content: '';
	}

	&__tab:hover {
		background: white;
		color: #5186ab;
	}

	&__panel {
		min-height: 415px;
		padding: 32px;
		animation: tab-in 0.4s var(--ease) both;
	}

	&__illustration {
		position: relative;
		height: 210px;
		margin-bottom: 20px;
		overflow: hidden;
		border: 1px solid #dce8ef;
		border-radius: 13px;
		background: linear-gradient(145deg, #f5f9fc, #e2edf5);
	}

	&__illustration--structure {
		display: grid;
		grid-template-columns: 1fr 1.5fr;
		grid-template-rows: 1fr 1fr;
		gap: 8px;
		padding: 32px 70px;
	}

	&__illustration--structure i {
		border: 1px solid #a8cae0;
		border-radius: 8px;
		background: rgba(155, 200, 232, 0.23);
		box-shadow: 0 8px 20px rgba(96, 141, 173, 0.07);
	}

	&__illustration--structure i:first-child {
		grid-row: span 2;
		background: #c5bce8;
		opacity: 0.55;
	}

	&__illustration--structure i:last-child {
		grid-column: 2;
	}

	&__illustration--motion i {
		position: absolute;
		top: 50%;
		width: 92px;
		height: 92px;
		border: 1px solid #a6cde4;
		border-radius: 50%;
		background: rgba(155, 200, 232, 0.25);
		transform: translateY(-50%);
		animation: motion-loop 3s ease-in-out infinite;
	}

	&__illustration--motion i:nth-child(1) {
		left: 20%;
	}

	&__illustration--motion i:nth-child(2) {
		left: 40%;
		width: 66px;
		height: 66px;
		background: rgba(197, 188, 232, 0.5);
		animation-delay: -0.7s;
	}

	&__illustration--motion i:nth-child(3) {
		left: 58%;
		width: 42px;
		height: 42px;
		background: #a8cfe8;
		animation-delay: -1.4s;
	}

	&__illustration--adaptive i {
		position: absolute;
		bottom: 28px;
		border: 4px solid #9dbfd7;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.6);
		box-shadow: 0 10px 20px rgba(91, 131, 159, 0.1);
	}

	&__illustration--adaptive i:nth-child(1) {
		left: 16%;
		width: 46%;
		height: 132px;
	}

	&__illustration--adaptive i:nth-child(2) {
		left: 59%;
		width: 19%;
		height: 95px;
	}

	&__illustration--adaptive i:nth-child(3) {
		left: 80%;
		width: 9%;
		height: 63px;
	}

	&__index {
		color: #7e9eb7;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	&__panel h3 {
		margin: 6px 0 8px;
		font-size: 26px;
		font-weight: 600;
		letter-spacing: -0.04em;
	}

	&__panel p {
		max-width: 450px;
		margin: 0;
		color: #697f90;
		font-size: 14px;
		line-height: 1.6;
	}
}

@keyframes tab-in {
	from {
		opacity: 0;
		transform: translateY(8px);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}
}

@keyframes motion-loop {
	50% {
		transform: translate(12px, -60%);
	}
}

@media (max-width: 1000px) {
	.about {
		&__layout {
			grid-template-columns: 1fr;
			gap: 45px;
		}

		&__description {
			max-width: 600px;
		}
	}

	.approach-tabs {
		max-width: 680px;
	}
}

@media (max-width: 767px) {
	.about {
		&__description {
			margin: 22px 0 25px;
			font-size: 15px;
		}
	}

	.approach-tabs {
		&__tab {
			min-height: 62px;
			gap: 5px;
			padding: 8px 4px;
			font-size: 9px;
		}

		&__tab span {
			font-size: 11px;
		}

		&__panel {
			min-height: 385px;
			padding: 20px;
		}

		&__illustration {
			height: 195px;
		}

		&__illustration--structure {
			padding: 30px;
		}
	}
}

@media (max-width: 374px) {
	.approach-tabs {
		&__tab {
			flex-direction: column;
		}
	}
}
