.libraries {
	background: #edf4f9;

	&__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	&__card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 555px;
		padding: clamp(24px, 3vw, 38px);
		border: 1px solid #d5e3ee;
		border-radius: 26px;
		box-shadow: 0 22px 60px rgba(38, 67, 89, 0.06);
	}

	&__card--flags {
		background: linear-gradient(145deg, #fafdff, #dfeef7);
	}

	&__card--svg {
		background: linear-gradient(145deg, #f8f7ff, #e4eef7);
	}

	&__card--badges {
		grid-column: 1 / -1;
		min-height: 310px;
		gap: 24px;
		background: linear-gradient(115deg, #e6eef8, #f9fcff 67%);
	}

	&__badges-layout {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: center;
		gap: clamp(30px, 5vw, 80px);
		flex: 1;
		min-width: 0;
	}

	&__badges {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(10px, 1.5vw, 20px);
		min-width: 0;
	}

	&__badges img {
		display: block;
		flex: 1 1 0%;
		max-width: 205px;
		min-width: 0;
		height: auto;
	}

	&__card--badges &__card-copy {
		margin: 0;
	}

	&__card-meta {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		color: #6a879b;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	&__flags {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: clamp(9px, 2vw, 22px);
		min-height: 245px;
		perspective: 700px;
	}

	&__flags img {
		width: clamp(58px, 7vw, 86px);
		height: auto;
		max-height: 62px;
		object-fit: contain;
		border-radius: 4px;
		box-shadow: 0 15px 28px rgba(28, 65, 92, 0.15);
		transform: rotate(-7deg) translateY(7px);
	}

	&__flags img:nth-child(even) {
		transform: rotate(8deg) translateY(-7px);
	}

	&__card-copy {
		margin-top: auto;
	}

	&__card-copy h3 {
		margin: 0 0 14px;
		font-size: clamp(31px, 3vw, 42px);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1.05;
	}

	&__card-copy p {
		max-width: 430px;
		min-height: 75px;
		margin: 0 0 22px;
		color: #637b8e;
		font-size: 15px;
		line-height: 1.6;
	}

	&__card .text-link {
		justify-content: space-between;
		width: 190px;
		max-width: 100%;
	}

	&__shapes {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: center;
		gap: 8px;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
		margin-block: 28px 30px;
		min-height: 245px;
	}

	&__shape {
		display: grid;
		place-items: center;
		min-width: 0;
		aspect-ratio: 1;
		border: 1px solid rgba(137, 173, 202, 0.24);
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.42);
		color: #85a9d4;
	}

	&__shape img {
		width: 82%;
		height: 82%;
		object-fit: contain;
	}

	&__shape--original img {
		width: 55%;
		height: 70%;
		object-fit: contain;
		filter: hue-rotate(145deg) saturate(0.7);
	}
}

@media (max-width: 900px) {
	.libraries {
		&__grid {
			grid-template-columns: 1fr;
		}

		&__card {
			min-height: 480px;
		}

		&__badges-layout {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		&__badges {
			min-height: 130px;
		}
	}
}

@media (max-width: 450px) {
	.libraries {
		&__card {
			min-height: 430px;
			padding: 22px;
		}

		&__card--badges {
			min-height: 0;
		}

		&__flags, &__shapes {
			min-height: 190px;
		}

		&__flags img {
			width: clamp(46px, 14vw, 68px);
		}

		&__card-copy p {
			min-height: 0;
			font-size: 14px;
		}
	}
}
