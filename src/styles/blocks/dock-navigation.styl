.dock-nav {
	position: fixed;
	z-index: 70;
	bottom: 18px;
	left: 50%;
	display: flex;
	align-items: center;
	width: max-content;
	max-width: calc(100% - 48px);
	padding: 6px;
	border: 1px solid rgba(255, 255, 255, 0.6);
	border-radius: 999px;
	background: linear-gradient(130deg, rgba(255, 255, 255, 0.72), rgba(220, 237, 248, 0.6));
	box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 18px 55px rgba(23, 49, 69, 0.16);
	backdrop-filter: blur(24px) saturate(1.6);
	opacity: 0;
	visibility: hidden;
	transform: translate(-50%, calc(100% + 36px));
	transition: opacity 0.3s, visibility 0.3s, transform 0.3s var(--ease);

	&.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
	}

	&__viewport {
		display: flex;
		gap: 6px;
		min-width: 0;
	}

	&__link {
		flex: none;
		padding: 10px 11px;
		border-radius: 999px;
		color: #274b63;
		font-size: 12px;
		font-weight: 700;
		white-space: nowrap;
		transition: background-color 0.25s, color 0.25s;
	}

	&__link:hover {
		background: #e6f0f8;
		color: #153b56;
	}

	&__link[aria-current='location'] {
		background: #153b56;
		color: #fff;
	}
}

@media (max-width: 850px) {
	.dock-nav {
		display: none;
	}
}
