.site-footer {
	background: #101820;
	color: #b6c5d0;

	&__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 8px;
		min-height: 64px;
	}

	&__brand {
		justify-self: start;
		color: #e9f0f7;
		font-size: 18px;
		font-weight: 700;
		letter-spacing: -0.04em;
		transition: color 0.2s;
	}

	&__brand:hover {
		color: #9bc8e8;
	}

	&__year {
		justify-self: center;
		font-size: 12px;
	}
}

@media (max-width: 850px) {
	.site-footer {
		&__inner {
			padding-block: 28px;
		}

		&__brand {
			font-size: 16px;
		}
	}
}
