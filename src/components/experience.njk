<section class="experience section" id="experience" aria-labelledby="experience-title">
	<div class="container">
		<div class="section-heading experience__heading" data-reveal>
			<div>
				<p class="eyebrow"><span class="eyebrow__line"></span> 07 / ПРАКТИКА</p>
				<h2 class="section-heading__title" id="experience-title">
					Навыки и<br /><em>опыт работы.</em>
				</h2>
			</div>
			<p class="section-heading__aside">
				Коммерческая разработка, проектная вёрстка и собственные веб-проекты.
			</p>
		</div>
		<div class="experience__layout">
			<div class="experience__skills" aria-labelledby="experience-skills-title" data-reveal>
				<h3 class="experience__column-title" id="experience-skills-title">Чем работаю</h3>
				{% for group in skillGroups %}
					<div class="experience__skill-group">
						<h4>{{ group.title }}</h4>
						<ul class="experience__skill-list">
							{% for skill in group.items %}<li>{{ skill }}</li>{% endfor %}
						</ul>
					</div>
				{% endfor %}
			</div>
			<div class="experience__work" aria-labelledby="experience-work-title" data-reveal>
				<h3 class="experience__column-title" id="experience-work-title">Где работал</h3>
				<ol class="experience__timeline">
					{% for job in jobs %}
						<li
							class="experience__job{% if job.current %}experience__job--current{% endif %}"
						>
							<div class="experience__job-header">
								<h4>{{ job.company }}</h4>
								<span class="experience__job-period">{{ job.period }}</span>
							</div>
							<p class="experience__job-role">{{ job.position }}</p>
							<p class="experience__job-description">{{ job.description }}</p>
						</li>
					{% endfor %}
				</ol>
			</div>
		</div>
	</div>
</section>
