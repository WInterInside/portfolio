<section class="projects section" id="projects" aria-labelledby="projects-title">
	<div class="container">
		<div class="section-heading" data-reveal>
			<div>
				<p class="eyebrow"><span class="eyebrow__line"></span> 01 / ИЗБРАННОЕ</p>
				<h2 class="section-heading__title" id="projects-title">
					Проекты, в которых<br /><em>важны детали</em>
				</h2>
			</div>
			<p class="section-heading__aside">
				От выразительных портфолио до сайтов с чёткой деловой задачей.
			</p>
		</div>
	</div>

	<div class="project-showcase" data-carousel data-reveal aria-label="Избранные проекты">
		<div
			class="project-showcase__viewport"
			tabindex="0"
			role="region"
			aria-roledescription="карусель"
			aria-label="Проекты. Стрелки переключают проекты"
			data-carousel-viewport
		>
			<div class="project-showcase__track">
				{% for item in projects %}
					{% include "components/project-slide.njk" %}
				{% endfor %}
			</div>
		</div>
		<div class="project-showcase__controls container">
			<div class="project-showcase__counter" aria-live="polite" aria-atomic="true">
				<strong data-carousel-current>{% for item in projects %}{% if item.slug == 'fishart' %}{{ loop.index | padNumber }}{% endif %}{% endfor %}</strong
				><span>/ {{ projects.length | padNumber }}</span>
			</div>
			<div class="project-showcase__progress" aria-hidden="true">
				<span data-carousel-progress></span>
			</div>
			<div class="project-showcase__actions">
				<button
					class="icon-button"
					type="button"
					data-carousel-prev
					aria-label="Предыдущий проект"
				>
					←
				</button>
				<button
					class="icon-button"
					type="button"
					data-carousel-next
					aria-label="Следующий проект"
				>
					→
				</button>
			</div>
		</div>
	</div>
	<dialog class="project-preview" data-project-preview aria-labelledby="project-preview-title">
		<div class="project-preview__header">
			<div>
				<span class="project-preview__eyebrow" data-preview-eyebrow>ПРОСМОТР ПРОЕКТА</span>
				<h3
					class="project-preview__title"
					id="project-preview-title"
					data-preview-heading
				></h3>
			</div>
			<div class="project-preview__controls">
				<button
					class="project-preview__zoom"
					type="button"
					data-preview-zoom
					aria-pressed="false"
				>
					Увеличить
				</button>
				<button
					class="project-preview__close"
					type="button"
					data-preview-close
					aria-label="Закрыть просмотр"
				>
					×
				</button>
			</div>
		</div>
		<div
			class="project-preview__scroll"
			data-preview-scroll
			tabindex="0"
			aria-label="Прокручиваемый снимок проекта или письма"
		>
			<img class="project-preview__image" data-preview-image alt="" />
		</div>
	</dialog>
</section>
