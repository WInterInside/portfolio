{% from "components/snowflake.njk" import snowflake %}
<section class="hero" id="top" aria-labelledby="hero-title">
	<div class="hero__glow hero__glow--one" aria-hidden="true"></div>
	<div class="hero__glow hero__glow--two" aria-hidden="true"></div>
	<div class="hero__inner container">
		<div class="hero__copy" data-reveal>
			<div class="eyebrow"><span class="eyebrow__line"></span> ПОРТФОЛИО / FRONTEND</div>
			<h1 class="hero__title" id="hero-title">
				Создаю<br /><span>интерфейсы</span><br />с характером
			</h1>
			<p class="hero__description">
				Меня зовут Максим. Разрабатываю адаптивные сайты и интерактивные веб-интерфейсы, в
				которых форма помогает содержанию.
			</p>
			<div class="hero__actions">
				<a class="button button--primary" href="#projects"
					>Смотреть проекты <span aria-hidden="true">↘</span></a
				>
				<a
					class="button button--telegram"
					href="https://t.me/WinterInside"
					target="_blank"
					rel="noopener noreferrer"
					>Связаться
					<svg class="button__telegram-icon" viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="m21 3-3.2 17-5.4-4.3-3.2 2.9.7-5.1L20.8 3.2 7.8 12.2 3 10.8 21 3Z"
							fill="currentColor"
						/></svg
				></a>
			</div>
		</div>

		<div class="hero-art">
			<div class="hero-art__orbit hero-art__orbit--outer" aria-hidden="true"></div>
			<div class="hero-art__orbit hero-art__orbit--inner" aria-hidden="true"></div>
			<div class="hero-art__spark hero-art__spark--one" aria-hidden="true">{{ snowflake() }}</div>
			<div class="hero-art__spark hero-art__spark--two" aria-hidden="true">✦</div>
			<div class="hero-art__card hero-art__card--back" aria-hidden="true">
				<span class="hero-art__card-label">01 / WINTER</span>
			</div>
			<div class="hero-art__card hero-art__card--front">
				<div class="hero-art__card-top" aria-hidden="true">
					<span class="hero-art__card-dots">● ● ●</span><span>LOCAL / TIME</span>
				</div>
				<time class="hero-art__clock" data-clock>
					<span class="hero-art__clock-display">
						<span data-clock-time>--:--</span>
						<span class="hero-art__clock-seconds" data-clock-seconds>--</span>
					</span>
					<span class="hero-art__clock-weekday" data-clock-weekday>День недели</span>
					<span class="hero-art__clock-date" data-clock-date>Дата</span>
				</time>
			</div>
			<div class="hero-art__floating-label" aria-hidden="true">Форма + функция {{ snowflake() }}</div>
		</div>

		<div class="hero__bottom" data-reveal>
			<span>01 / 12 — ЗНАКОМСТВО</span>
			<span class="hero__scroll-note">Листайте вниз <span aria-hidden="true">↓</span></span>
		</div>
	</div>
</section>
