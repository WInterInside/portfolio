<section class="emails section" id="emails" aria-labelledby="emails-title">
	<div class="container">
		<div class="section-heading" data-reveal>
			<div>
				<p class="eyebrow"><span class="eyebrow__line"></span> 06 / HTML-ПИСЬМА</p>
				<h2 class="section-heading__title" id="emails-title">
					Вёрстка, которая<br /><em>доходит до адресата</em>
				</h2>
			</div>
			<p class="section-heading__aside">
				От яркой рассылки до компактного сервисного письма с важными деталями.
			</p>
		</div>
		<div class="emails__grid">
			<article class="emails__card" data-reveal>
				<div class="emails__visual emails__visual--sheer" aria-hidden="true">
					<div class="emails__mail-window">
						<div class="emails__mail-bar"><span></span><span></span><span></span></div>
						<img
							src="./assets/libraries/sheer-mail-banner.png"
							alt=""
							loading="lazy"
							width="500"
							height="212"
						/>
					</div>
				</div>
				<div class="emails__card-body">
					<span class="emails__type">Рассылки / SHEER</span>
					<h3>Промо-письма</h3>
					<p>
						Серия HTML-писем для студии: табличная структура, изображения, типографика и
						адаптация под узкий экран.
					</p>
					<div class="emails__actions">
						<button
							class="button button--primary"
							type="button"
							data-preview-open
							data-preview-title="Промо-письмо SHEER"
							data-preview-src="./assets/libraries/sheer-mail-full.png"
							data-preview-kind="письма"
						>
							Посмотреть <span aria-hidden="true">↗</span></button
						><a
							class="button button--outline"
							href="https://github.com/WInterInside/sheer-mails"
							target="_blank"
							rel="noopener noreferrer"
							>Код письма <span aria-hidden="true">↗</span></a
						>
					</div>
				</div>
			</article>
			<article class="emails__card" data-reveal>
				<div class="emails__visual emails__visual--ohta" aria-hidden="true">
					<div class="emails__ticket">
						<img src="./assets/libraries/ohta-logo.png" alt="" loading="lazy" /><span
							>ВХОДНОЙ БИЛЕТ</span
						><i></i><small>Детали посещения</small><b></b><b></b
						><b class="emails__ticket-line--short"></b>
					</div>
				</div>
				<div class="emails__card-body">
					<span class="emails__type">Сервисное письмо / Охта Парк</span>
					<h3>Электронный билет</h3>
					<p>
						Шаблон письма с подтверждением и данными посещения. Простая структура
						помогает быстро найти главное.
					</p>
					<div class="emails__actions">
						<button
							class="button button--primary"
							type="button"
							data-preview-open
							data-preview-title="Электронный билет Охта Парка"
							data-preview-src="./assets/libraries/ohta-mail-full.png"
							data-preview-kind="письма"
						>
							Посмотреть <span aria-hidden="true">↗</span></button
						><a
							class="button button--outline"
							href="https://github.com/WInterInside/ohta-park-mail"
							target="_blank"
							rel="noopener noreferrer"
							>Код письма <span aria-hidden="true">↗</span></a
						>
					</div>
				</div>
			</article>
			<article class="emails__card emails__card--wide" data-reveal>
				<div class="emails__visual emails__visual--sales" aria-hidden="true">
					<div class="emails__mail-window">
						<div class="emails__mail-bar"><span></span><span></span><span></span></div>
						<img
							src="./assets/libraries/sheer-increase-sales.png"
							alt=""
							loading="lazy"
						/>
					</div>
				</div>
				<div class="emails__card-body">
					<span class="emails__type">Рассылка / SHEER</span>
					<h3>Письмо для производителей</h3>
					<p>
						Отдельный HTML-шаблон из серии SHEER: крупный заголовок, последовательные
						смысловые блоки и заметный призыв к действию.
					</p>
					<div class="emails__actions">
						<button
							class="button button--primary"
							type="button"
							data-preview-open
							data-preview-title="Письмо SHEER для производителей"
							data-preview-src="./assets/libraries/sheer-increase-sales.png"
							data-preview-kind="письма"
						>
							Посмотреть <span aria-hidden="true">↗</span></button
						><a
							class="button button--outline"
							href="https://github.com/WInterInside/sheer-mails/blob/master/increase_sales.html"
							target="_blank"
							rel="noopener noreferrer"
							>Код письма <span aria-hidden="true">↗</span></a
						>
					</div>
				</div>
			</article>
		</div>
	</div>
</section>
